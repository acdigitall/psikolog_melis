# Bu dosyayı "app/.env" adıyla kopyalayıp değerleri doldurun.

# Hostinger > Veritabanları bölümündeki bilgiler (şifredeki özel karakterler URL kodlu olmalı)
DATABASE_URL=mysql://KULLANICI:SIFRE@localhost:3306/VERITABANI

# Sitenin gerçek adresi (sonunda / olmadan)
SITE_URL=https://alanadiniz.com

ADMIN_EMAIL=admin@alanadiniz.com

# Üretmek için: php app/tools/sifre-olustur.php 'YeniSifre'
ADMIN_PASSWORD_HASH=

# En az 32 karakter. Üretmek için: openssl rand -hex 32
SESSION_SECRET=

# İsteğe bağlı
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
BING_VERIFICATION=

# Seans sonrası SMS zamanlayıcı bağlantısı (/cron/sms?key=...) için gizli anahtar, en az 16 karakter.
# Boş bırakılırsa SESSION_SECRET'tan türetilir. NetGSM bilgileri yönetim panelinden (SMS Ayarları) girilir.
CRON_SECRET=
